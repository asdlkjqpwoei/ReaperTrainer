{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}\\build\\vs2026"
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug",
      "displayName": "Visual Studio 2026 Debug x64",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "displayName": "Visual Studio 2026 Release x64",
      "configurePreset": "vs2026",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "vs2026-debug",
      "displayName": "Visual Studio 2026 Debug Tests",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2026-release",
      "displayName": "Visual Studio 2026 Release Tests",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
